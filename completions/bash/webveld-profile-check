# bash completion for webveld-profile-check

_webveld_profile_check() {
    local cur prev words cword
    _init_completion || return

    case "$cur" in
        --profile=*)
            local p="${cur#--profile=}"
            COMPREPLY=($(compgen -W 'nano pico' -P '--profile=' -- "$p"))
            return 0
            ;;
        --*)
            COMPREPLY=($(compgen -W '--profile=' -- "$cur"))
            [[ ${#COMPREPLY[@]} -eq 1 && $COMPREPLY == *= ]] && compopt -o nospace 2>/dev/null
            return 0
            ;;
    esac

    case "$prev" in
        --profile)
            COMPREPLY=($(compgen -W 'nano pico' -- "$cur"))
            return 0
            ;;
    esac

    # Complete HTML and CSS files
    _filedir '@(htm|html|css)'
} &&
complete -F _webveld_profile_check webveld-profile-check webveld-profile-check.lua
